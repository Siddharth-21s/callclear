APP_NAME=CallClear
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
STORAGE_DIR=data
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=callclear
DEFAULT_SAMPLE_RATE=16000
TELEPHONY_SAMPLE_RATE=8000
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=hi
ASR_BEAM_SIZE=5
HF_DATASET=google/fleurs
HF_CONFIG=hi_in
BENCHMARK_SPLIT=test
BENCHMARK_LIMIT=200
PACKET_LOSS_MS=60
