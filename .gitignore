__pycache__/
*.py[cod]

.venv/
.env
.python-version

.DS_Store
.vscode/
.idea/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Keep uv.lock in a real project for reproducible installs.
# This repository ships a lockfile generated by uv.

# Local datasets and generated audio
data/raw/*
data/degraded/*
data/enhanced/*
!data/raw/.gitkeep
!data/degraded/.gitkeep
!data/enhanced/.gitkeep

# Generated benchmark audio
results/*.wav

# Track reproducible benchmark metadata and visual results.
# These files are intentionally committed.
results/*
!results/.gitkeep
!results/references.json
!results/benchmark_results.csv
!results/benchmark_summary.json
!results/wer_vs_snr.png

# Root-level model artifacts only
/models/
*.bin
*.pt
*.onnx
*.safetensors